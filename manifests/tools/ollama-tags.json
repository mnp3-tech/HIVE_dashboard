{
  "version": "1.0.0",
  "enabled": false,
  "source": "hive-dashboard configuration (manifests/tools)",
  "id": "ollama-tags",
  "name": "Ollama model listing",
  "transport": "http-loopback",
  "endpoint": "http://127.0.0.1:11434/api/tags",
  "input_schema": {
    "type": "object",
    "properties": {}
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "models": {
        "type": "string"
      }
    }
  },
  "capabilities": [
    "models.list.local"
  ],
  "required_permissions": [
    "loopback.http.read"
  ],
  "risk": "low",
  "timeout_s": 2,
  "output_limit_bytes": 128000
}
